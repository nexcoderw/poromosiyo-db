generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                  String    @id @default(uuid()) @db.Char(36)
  fullName            String    @map("full_name") @db.VarChar(150)
  email               String    @unique @db.VarChar(254)
  image               String?   @db.VarChar(2048)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  role                UserRole  @default(CUSTOMER)
  isActive            Boolean   @default(true) @map("is_active")
  blockedAt           DateTime? @map("blocked_at") @db.DateTime(6)
  blockedReason       String?   @map("blocked_reason") @db.VarChar(500)
  blockedByUserId     String?   @map("blocked_by_user_id") @db.Char(36)
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.DateTime(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.DateTime(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.DateTime(6)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.DateTime(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  accounts                AuthAccount[]
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  blockedBy               User?                    @relation("UserBlockActor", fields: [blockedByUserId], references: [id], onDelete: SetNull)
  blockedUsers            User[]                   @relation("UserBlockActor")
  activities              UserActivity[]           @relation("ActivitySubject")
  performedActivities     UserActivity[]           @relation("ActivityActor")

  @@index([role, isActive], map: "users_role_active_idx")
  @@index([lockedUntil], map: "users_locked_until_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@index([blockedAt], map: "users_blocked_at_idx")
  @@index([blockedByUserId], map: "users_blocked_by_user_id_idx")
  @@map("users")
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Char(36)
  userId            String       @map("user_id") @db.Char(36)
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], map: "auth_accounts_user_provider_key")
  @@unique([provider, providerAccountId], map: "auth_accounts_provider_account_key")
  @@index([userId], map: "auth_accounts_user_id_idx")
  @@map("auth_accounts")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.DateTime(6)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(6)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(6)
  revocationReason String?   @map("revocation_reason") @db.VarChar(64)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_status_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@index([lastSeenAt], map: "auth_sessions_last_seen_at_idx")
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  sessionId String    @map("session_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt DateTime  @map("expires_at") @db.DateTime(6)
  usedAt    DateTime? @map("used_at") @db.DateTime(6)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt, expiresAt], map: "refresh_tokens_session_status_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  email       String    @db.VarChar(254)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(6)
  usedAt      DateTime? @map("used_at") @db.DateTime(6)
  requesterIp String?   @map("requester_ip") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email, expiresAt], map: "email_verify_user_email_idx")
  @@index([expiresAt], map: "email_verify_expires_at_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(6)
  usedAt      DateTime? @map("used_at") @db.DateTime(6)
  requesterIp String?   @map("requester_ip") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "password_reset_user_expires_idx")
  @@index([expiresAt], map: "password_reset_expires_at_idx")
  @@map("password_reset_tokens")
}

model UserActivity {
  id            String   @id @default(uuid()) @db.Char(36)
  subjectUserId String?  @map("subject_user_id") @db.Char(36)
  actorUserId   String?  @map("actor_user_id") @db.Char(36)
  action        String   @db.VarChar(100)
  resourceType  String?  @map("resource_type") @db.VarChar(64)
  resourceId    String?  @map("resource_id") @db.Char(36)
  description   String?  @db.VarChar(500)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(6)

  subjectUser User? @relation("ActivitySubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  actorUser   User? @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([subjectUserId, createdAt], map: "user_activities_subject_created_idx")
  @@index([actorUserId, createdAt], map: "user_activities_actor_created_idx")
  @@index([action, createdAt], map: "user_activities_action_created_idx")
  @@index([resourceType, resourceId, createdAt], map: "user_activities_resource_created_idx")
  @@index([createdAt], map: "user_activities_created_at_idx")
  @@map("user_activities")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  parentId    String?  @map("parent_id") @db.Char(36)
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(191)
  description String?  @db.Text
  image       String?  @db.VarChar(2048)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId, isActive, sortOrder], map: "categories_parent_active_sort_idx")
  @@index([isActive, sortOrder], map: "categories_active_sort_idx")
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(191)
  description String?  @db.Text
  logo        String?  @db.VarChar(2048)
  website     String?  @db.VarChar(2048)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  products Product[]

  @@index([isActive, name], map: "brands_active_name_idx")
  @@map("brands")
}

model Product {
  id               String        @id @default(uuid()) @db.Char(36)
  categoryId       String        @map("category_id") @db.Char(36)
  brandId          String?       @map("brand_id") @db.Char(36)
  name             String        @db.VarChar(255)
  slug             String        @unique @db.VarChar(191)
  sku              String        @unique @db.VarChar(64)
  shortDescription String?       @map("short_description") @db.VarChar(500)
  description      String?       @db.Text
  currency         String        @default("RWF") @db.Char(3)
  originalPrice    Decimal       @map("original_price") @db.Decimal(12, 2)
  sellingPrice     Decimal       @map("selling_price") @db.Decimal(12, 2)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  publishedAt      DateTime?     @map("published_at") @db.DateTime(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images   ProductImage[]

  @@index([categoryId, status, createdAt], map: "products_category_status_created_idx")
  @@index([brandId, status], map: "products_brand_status_idx")
  @@index([status, publishedAt], map: "products_status_published_idx")
  @@index([isFeatured, status], map: "products_featured_status_idx")
  @@index([createdAt], map: "products_created_at_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Char(36)
  productId String   @map("product_id") @db.Char(36)
  url       String   @db.VarChar(2048)
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder], map: "product_images_product_sort_idx")
  @@index([productId, isPrimary], map: "product_images_product_primary_idx")
  @@map("product_images")
}
