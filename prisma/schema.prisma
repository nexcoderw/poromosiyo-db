generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                  String    @id @default(uuid()) @db.Char(36)
  fullName            String    @map("full_name") @db.VarChar(150)
  email               String    @unique @db.VarChar(254)
  image               String?   @db.VarChar(2048)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  role                UserRole  @default(CUSTOMER)
  isActive            Boolean   @default(true) @map("is_active")
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.DateTime(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.DateTime(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.DateTime(6)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.DateTime(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  accounts                AuthAccount[]
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@index([role, isActive], map: "users_role_active_idx")
  @@index([lockedUntil], map: "users_locked_until_idx")
  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model AuthAccount {
  id                String       @id @default(uuid()) @db.Char(36)
  userId            String       @map("user_id") @db.Char(36)
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id") @db.VarChar(191)
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], map: "auth_accounts_provider_account_key")
  @@index([userId], map: "auth_accounts_user_id_idx")
  @@map("auth_accounts")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(6)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.DateTime(6)
  expiresAt        DateTime  @map("expires_at") @db.DateTime(6)
  revokedAt        DateTime? @map("revoked_at") @db.DateTime(6)
  revocationReason String?   @map("revocation_reason") @db.VarChar(64)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_status_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@index([lastSeenAt], map: "auth_sessions_last_seen_at_idx")
  @@map("auth_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  sessionId String    @map("session_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt DateTime  @map("expires_at") @db.DateTime(6)
  usedAt    DateTime? @map("used_at") @db.DateTime(6)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(6)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, revokedAt, expiresAt], map: "refresh_tokens_session_status_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  email       String    @db.VarChar(254)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(6)
  usedAt      DateTime? @map("used_at") @db.DateTime(6)
  requesterIp String?   @map("requester_ip") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, email, expiresAt], map: "email_verify_user_email_idx")
  @@index([expiresAt], map: "email_verify_expires_at_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String    @map("user_id") @db.Char(36)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(6)
  usedAt      DateTime? @map("used_at") @db.DateTime(6)
  requesterIp String?   @map("requester_ip") @db.VarChar(45)
  userAgent   String?   @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "password_reset_user_expires_idx")
  @@index([expiresAt], map: "password_reset_expires_at_idx")
  @@map("password_reset_tokens")
}
