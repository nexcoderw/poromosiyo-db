# Development database.
#
# This file contains placeholders only.
# Never commit the real .env file.
DATABASE_URL="mysql://poromosiyo_dev:change-me@localhost:3306/poromosiyo"

# Dedicated Prisma Migrate shadow database used by migrate:dev.
SHADOW_DATABASE_URL="mysql://poromosiyo_dev:change-me@localhost:3306/poromosiyo_shadow"

# Runtime database connection pool size.
DATABASE_CONNECTION_LIMIT=5

# Runtime NestJS consumers connect during module initialization by default.
DATABASE_CONNECT_ON_INIT=true
